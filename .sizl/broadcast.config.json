{
  "$schema": "https://broadcast.sizls.com/schema/broadcast-config-v1.json",
  "templates": {
    "bluesky": "🚀 ${ref.repo} ${ref.version}\n\n${ref.notes}\n\n${ref.url}",
    "mastodon": "🚀 ${ref.repo} ${ref.version}\n\n${ref.notes}\n\n${ref.url}",
    "discord": "**${ref.repo} ${ref.version}** shipped — ${ref.url}\n\n${ref.notes}"
  },
  "mastodonInstance": "https://hachyderm.io",
  "attackerScrub": {
    "trustedHosts": ["github.com", "directive.run", "broadcast.sizls.com"]
  },
  "tierPolicy": {
    "patch": "tier1.auto-post",
    "minor": "tier1.auto-post",
    "major": "tier1.auto-post",
    "recap": "tier1.auto-post",
    "manual": "tier1.auto-post"
  }
}
