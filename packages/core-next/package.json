{
  "name": "@directive-run/core-next",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#is-development": {
      "production": "./src/dev-false.ts",
      "default": "./src/dev-true.ts"
    }
  },
  "description": "Directive 2.0 engine, built layer by layer. Unpublished.",
  "license": "(MIT OR Apache-2.0)",
  "author": "Jason Comes",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "import": "./dist/development/index.js",
        "require": "./dist/development/index.cjs"
      },
      "production": {
        "import": "./dist/production/index.js",
        "require": "./dist/production/index.cjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./internals": {
      "development": {
        "import": "./dist/development/internals.js",
        "require": "./dist/development/internals.cjs"
      },
      "production": {
        "import": "./dist/production/internals.js",
        "require": "./dist/production/internals.cjs"
      },
      "require": {
        "types": "./dist/internals.d.cts",
        "default": "./dist/internals.cjs"
      },
      "import": {
        "types": "./dist/internals.d.ts",
        "default": "./dist/internals.js"
      }
    },
    "./plugins": {
      "development": {
        "import": "./dist/development/plugins.js",
        "require": "./dist/development/plugins.cjs"
      },
      "production": {
        "import": "./dist/production/plugins.js",
        "require": "./dist/production/plugins.cjs"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      },
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      }
    },
    "./testing": {
      "development": {
        "import": "./dist/development/testing.js",
        "require": "./dist/development/testing.cjs"
      },
      "production": {
        "import": "./dist/production/testing.js",
        "require": "./dist/production/testing.cjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      },
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./migration": {
      "development": {
        "import": "./dist/development/migration.js",
        "require": "./dist/development/migration.cjs"
      },
      "production": {
        "import": "./dist/production/migration.js",
        "require": "./dist/production/migration.cjs"
      },
      "require": {
        "types": "./dist/migration.d.cts",
        "default": "./dist/migration.cjs"
      },
      "import": {
        "types": "./dist/migration.d.ts",
        "default": "./dist/migration.js"
      }
    },
    "./adapter-utils": {
      "development": {
        "import": "./dist/development/adapter-utils.js",
        "require": "./dist/development/adapter-utils.cjs"
      },
      "production": {
        "import": "./dist/production/adapter-utils.js",
        "require": "./dist/production/adapter-utils.cjs"
      },
      "require": {
        "types": "./dist/adapter-utils.d.cts",
        "default": "./dist/adapter-utils.cjs"
      },
      "import": {
        "types": "./dist/adapter-utils.d.ts",
        "default": "./dist/adapter-utils.js"
      }
    },
    "./worker": {
      "development": {
        "import": "./dist/development/worker.js",
        "require": "./dist/development/worker.cjs"
      },
      "production": {
        "import": "./dist/production/worker.js",
        "require": "./dist/production/worker.cjs"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      },
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "cd ../.. && vitest run packages/core-next/",
    "typecheck": "tsc --noEmit",
    "bench": "cd ../.. && vitest bench --run packages/core-next/",
    "bench:fair": "pnpm build && node bench/run.mjs",
    "bench:system": "pnpm --filter @directive-run/core build && pnpm --filter @directive-run/core-next build && node bench/system/run.mjs",
    "size": "node scripts/size.mjs",
    "size:check": "node scripts/size.mjs --check",
    "size:tighten": "node scripts/size-budgets-tighten.mjs",
    "clean": "rm -rf dist",
    "pack:alpha": "node scripts/alpha/pack.mjs",
    "smoke:alpha": "node scripts/alpha/install-smoke.mjs",
    "consumer:alpha": "node scripts/alpha/consumer-check.mjs",
    "api-reference:alpha": "node scripts/alpha/api-reference.mjs"
  },
  "devDependencies": {
    "alien-signals": "3.1.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
