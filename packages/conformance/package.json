{
  "name": "@directive-run/conformance",
  "version": "0.0.0",
  "private": true,
  "description": "Black-box conformance suite for @directive-run/core: the same tests run against the published 1.35 engine (the reference) and the in-repo engine, and later core-next.",
  "type": "module",
  "scripts": {
    "port": "tsx scripts/port.ts",
    "check:expects": "tsx scripts/check-expects.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:v1": "vitest run --config vitest.config.ts --project conformance:v1 --project conformance:v1:prod",
    "test:local": "vitest run --config vitest.config.ts --project conformance:local --project conformance:local:prod",
    "test:checks": "vitest run --config vitest.config.ts --project conformance:checks",
    "census": "tsx scripts/census.ts",
    "diff:coverage": "tsx scripts/diff-coverage.ts",
    "oracle:guard": "tsx scripts/oracle-guard.ts",
    "oracle:update": "tsx scripts/oracle-update.ts",
    "pin:v1": "tsx scripts/pin-v1.ts",
    "contracts:freeze": "tsx contracts/scripts/freeze.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mutate": "cd ../.. && stryker run packages/conformance/stryker.config.mjs",
    "mutate:file": "cd ../.. && stryker run packages/conformance/stryker.config.mjs --mutate"
  },
  "dependencies": {
    "@directive-run/core": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^25.2.0",
    "directive-v1": "npm:@directive-run/core@1.35.0",
    "fast-check": "4.10.2",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
