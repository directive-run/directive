{
  "name": "@directive-run/ai",
  "version": "1.20.1",
  "description": "AI guardrails and orchestration for Directive. Prompt injection, PII detection, cost tracking, multi-agent patterns.",
  "license": "(MIT OR Apache-2.0)",
  "author": "Jason Comes",
  "repository": {
    "type": "git",
    "url": "https://github.com/directive-run/directive",
    "directory": "packages/ai"
  },
  "homepage": "https://directive.run",
  "bugs": {
    "url": "https://github.com/directive-run/directive/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "directive",
    "ai",
    "agents",
    "guardrails",
    "orchestration",
    "llm",
    "constraint-driven",
    "ai-safety",
    "prompt-injection",
    "pii-detection",
    "cost-tracking",
    "multi-agent",
    "openai",
    "anthropic",
    "ollama",
    "gemini"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.cjs",
      "import": "./dist/testing.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "require": "./dist/anthropic.cjs",
      "import": "./dist/anthropic.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "require": "./dist/openai.cjs",
      "import": "./dist/openai.js"
    },
    "./ollama": {
      "types": "./dist/ollama.d.ts",
      "require": "./dist/ollama.cjs",
      "import": "./dist/ollama.js"
    },
    "./gemini": {
      "types": "./dist/gemini.d.ts",
      "require": "./dist/gemini.cjs",
      "import": "./dist/gemini.js"
    },
    "./multi-agent": {
      "types": "./dist/multi-agent.d.ts",
      "require": "./dist/multi-agent.cjs",
      "import": "./dist/multi-agent.js"
    },
    "./predicate": {
      "types": "./dist/predicate.d.ts",
      "require": "./dist/predicate.cjs",
      "import": "./dist/predicate.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails.d.ts",
      "require": "./dist/guardrails.cjs",
      "import": "./dist/guardrails.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "require": "./dist/devtools.cjs",
      "import": "./dist/devtools.js"
    },
    "./evals": {
      "types": "./dist/evals.d.ts",
      "require": "./dist/evals.cjs",
      "import": "./dist/evals.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "require": "./dist/mcp.cjs",
      "import": "./dist/mcp.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "cd ../.. && vitest run packages/ai/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@directive-run/core": "^1.0.0"
  },
  "devDependencies": {
    "@directive-run/core": "workspace:*",
    "@types/node": "^25.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
