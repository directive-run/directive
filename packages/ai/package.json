{
  "name": "@directive-run/ai",
  "version": "1.35.0",
  "description": "AI guardrails and orchestration for Directive. Prompt injection, PII detection, cost tracking, multi-agent patterns.",
  "license": "(MIT OR Apache-2.0)",
  "author": "Jason Comes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/directive-run/directive.git",
    "directory": "packages/ai"
  },
  "homepage": "https://directive.run",
  "bugs": {
    "url": "https://github.com/directive-run/directive/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "directive",
    "ai",
    "agents",
    "guardrails",
    "orchestration",
    "llm",
    "constraint-driven",
    "ai-safety",
    "prompt-injection",
    "pii-detection",
    "cost-tracking",
    "multi-agent",
    "openai",
    "anthropic",
    "ollama",
    "gemini",
    "workers-ai"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
