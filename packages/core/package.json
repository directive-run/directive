{
  "name": "@directive-run/core",
  "version": "1.35.0",
  "imports": {
    "#is-development": {
      "production": "./src/dev-false.ts",
      "default": "./src/dev-true.ts"
    }
  },
  "description": "The constraint-driven runtime for TypeScript. Declare what must be true — the runtime makes it happen.",
  "license": "(MIT OR Apache-2.0)",
  "author": "Jason Comes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/directive-run/directive.git",
    "directory": "packages/core"
  },
  "homepage": "https://directive.run",
  "bugs": {
    "url": "https://github.com/directive-run/directive/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "directive",
    "constraint-driven",
    "state-management",
    "constraints",
    "reactive",
    "runtime",
    "typescript",
    "ai-guardrails",
    "zero-dependencies",
    "auto-tracking",
    "framework-agnostic",
    "declarative"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "import": "./dist/development/index.js",
        "require": "./dist/development/index.cjs"
      },
      "production": {
        "import": "./dist/production/index.js",
        "require": "./dist/production/index.cjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./internals": {
      "development": {
        "import": "./dist/development/internals.js",
        "require": "./dist/development/internals.cjs"
      },
      "production": {
        "import": "./dist/production/internals.js",
        "require": "./dist/production/internals.cjs"
      },
      "require": {
        "types": "./dist/internals.d.cts",
        "default": "./dist/internals.cjs"
      },
      "import": {
        "types": "./dist/internals.d.ts",
        "default": "./dist/internals.js"
      }
    },
    "./plugins": {
      "development": {
        "import": "./dist/development/plugins/index.js",
        "require": "./dist/development/plugins/index.cjs"
      },
      "production": {
        "import": "./dist/production/plugins/index.js",
        "require": "./dist/production/plugins/index.cjs"
      },
      "require": {
        "types": "./dist/plugins/index.d.cts",
        "default": "./dist/plugins/index.cjs"
      },
      "import": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      }
    },
    "./testing": {
      "development": {
        "import": "./dist/development/testing.js",
        "require": "./dist/development/testing.cjs"
      },
      "production": {
        "import": "./dist/production/testing.js",
        "require": "./dist/production/testing.cjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      },
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./migration": {
      "development": {
        "import": "./dist/development/migration.js",
        "require": "./dist/development/migration.cjs"
      },
      "production": {
        "import": "./dist/production/migration.js",
        "require": "./dist/production/migration.cjs"
      },
      "require": {
        "types": "./dist/migration.d.cts",
        "default": "./dist/migration.cjs"
      },
      "import": {
        "types": "./dist/migration.d.ts",
        "default": "./dist/migration.js"
      }
    },
    "./adapter-utils": {
      "development": {
        "import": "./dist/development/adapter-utils.js",
        "require": "./dist/development/adapter-utils.cjs"
      },
      "production": {
        "import": "./dist/production/adapter-utils.js",
        "require": "./dist/production/adapter-utils.cjs"
      },
      "require": {
        "types": "./dist/adapter-utils.d.cts",
        "default": "./dist/adapter-utils.cjs"
      },
      "import": {
        "types": "./dist/adapter-utils.d.ts",
        "default": "./dist/adapter-utils.js"
      }
    },
    "./worker": {
      "development": {
        "import": "./dist/development/worker.js",
        "require": "./dist/development/worker.cjs"
      },
      "production": {
        "import": "./dist/production/worker.js",
        "require": "./dist/production/worker.cjs"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      },
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "cd ../.. && vitest run packages/core/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
