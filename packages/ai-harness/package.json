{
  "name": "@sizls/ai-harness",
  "version": "0.1.10",
  "private": true,
  "description": "Configurable persona-chain engine. Personas take turns on a shared transcript until a USD budget runs out, then a synthesizer closes it out.",
  "license": "(MIT OR Apache-2.0)",
  "author": "Jason Comes",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "require": "./dist/node.cjs",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "presets", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "cd ../.. && vitest run packages/ai-harness/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@directive-run/ai": "workspace:*",
    "@directive-run/core": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
